{
  "version": 2,
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "VITE_API_BASE_URL=https://cbk-backend.vercel.app VITE_BRAND_LOGO_URL=https://cbk-gamma.vercel.app/logo.jpeg npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}